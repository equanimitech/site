---
import Base from "../layouts/Base.astro";
import Section from "../components/Section.astro";

const title = "Zenborg · equanimi.tech";
const description =
  "Make most moments matter. Zenborg is an intention orchestration system for budgeting moments toward personal flourishing.";
const pitch =
  "Zenborg is a garden for your attention: plant what you want to grow, grow it with the people and places you care about, fence out the weeds, and return to tend it every day.";
const nots = [
  ["task manager", "no tasks, no checklists, no \"done\", no projects, no goals, no outcomes"],
  ["habit tracker", "no streaks, no points, no badges and, definitely, no leaderboards"],
  ["calendar", "no reminders, no notifications"],
  ["screen-time app", "no lockouts, no shame, no daily report card"],
];
const download = "https://github.com/equanimitech/zenborg/releases/latest";

const gestures = [
  {
    name: "🌱 Plant",
    tag: "What you want to grow.",
    body: "Areas are the plots of your life. Habits are perennials. Moments are today's intentions, one to three words. Cycles are seasons.",
  },
  {
    name: "🤝 Companion",
    tag: "Who and where you grow it with.",
    body: "People and places, each held with an intention. Relation, not record.",
  },
  {
    name: "🚧 Fence",
    tag: "Keep the weeds out.",
    body: "Fence out the sites and feeds that crowd the garden. A pause and some friction at the boundary, not lockouts and shame.",
  },
  {
    name: "🪴 Tend",
    tag: "Come back to it.",
    body: "Daily and seasonal rituals: sunrise, sunset, weather, season. Returning, not nagging.",
  },
];

// TODO(screenshots): drop images in public/zenborg/ and swap each
// placeholder <div> for <img src={s.src} alt={s.alt} loading="lazy" />.
const shots = [
  {
    src: "/zenborg/day.png",
    alt: "The day view: moments tended across morning, afternoon and evening.",
    caption: "The day, in phases.",
  },
  {
    src: "/zenborg/garden.png",
    alt: "The garden: areas of life with their habits.",
    caption: "The garden, by area.",
  },
  {
    src: "/zenborg/fence.png",
    alt: "A fence pausing a visit to a site that was fenced out.",
    caption: "A pause at the fence.",
  },
];
---
<Base title={title} description={description} path="/zenborg">
  <main>
    <header class="zb-hero">
      <p class="eyebrow">Zenborg</p>
      <h1 class="zb-hero__name">Make most moments matter</h1>
      <p class="zb-hero__pitch">
        Zenborg is an intention orchestration system for budgeting moments
        toward personal flourishing. It's a simple tool to make your
        intentions explicit, tangible and adaptable throughout the day.
      </p>
      <p class="research-q-inline">"Where will I place my consciousness today?"</p>
      <p class="zb-hero__meta">
        macOS · Apple Silicon · local-first · <a href="#get">Get it</a>
      </p>
    </header>

    <Section id="how" eyebrow="How it works">
      <p class="prose">{pitch}</p>
      <div class="projects">
        {gestures.map((g) => (
          <article class="project">
            <h2 class="project__name">{g.name}</h2>
            <p class="project__tag">{g.tag}</p>
            <p class="project__body">{g.body}</p>
          </article>
        ))}
      </div>
    </Section>

    <Section id="looks" eyebrow="How it looks">
      <div class="zb-shots">
        {shots.map((s) => (
          <figure class="zb-shot">
            {/* TODO(screenshot): replace with <img src={s.src} alt={s.alt} /> */}
            <div class="zb-shot__slot" role="img" aria-label={s.alt}>
              <span>Screenshot to come: {s.src}</span>
            </div>
            <figcaption>{s.caption}</figcaption>
          </figure>
        ))}
      </div>
    </Section>

    <Section id="limits" eyebrow="Liberating limits">
      <p class="prose">
        We tend to see limits as a problem. If we are limited, we aren't
        free. If we aren't free, well, that's just plain bad.
      </p>
      <ul class="zb-list">
        <li>3 words to a moment</li>
        <li>phases, not hours</li>
      </ul>
    </Section>

    <Section id="not" eyebrow="What this is NOT">
      <p class="prose">It looks like just another productivity tool, but...</p>
      <ul class="zb-list">
        {nots.map(([what, why]) => (
          <li><strong>it's not a {what}:</strong> {why}</li>
        ))}
        <li><strong>it's not a platform:</strong> no accounts, no servers, no analytics, no ads</li>
      </ul>
      <p class="prose zb-after">
        All of these tools can be useful in their own right, for their own
        purposes. However, we are exploring a mindful alternative to these
        conventional paradigms.
      </p>
    </Section>

    <Section id="why" eyebrow="Why it matters">
      <div class="note__body prose">
        <details>
          <summary>We, the users, are being used.</summary>
          <p>
            Our attention is consistently exploited for profit by content
            platforms Instagram, TikTok, YouTube, Netflix and the like.
          </p>
          <p>
            Attention creates engagement. Engagement drives ad revenue. Ad
            revenue increases profits.
          </p>
          <p>
            This is the attention economy. Tech giants in a free-for-all to
            capture our gaze. The tragedy of commons of human attention. Not
            only are they competing between themselves, but they're also
            competing with us.
          </p>
          <blockquote>
            <p>
              "You know, think about it, when you watch a show from Netflix
              and you get addicted to it, you stay up late at night. We're
              competing with sleep, on the margin. And so, it's a very large
              pool of time."
            </p>
            <p><cite>Reed Hastings, Netflix CEO</cite></p>
          </blockquote>
          <p>
            We, the users, are their biggest competitors. Investing time in
            ourselves means not spending it in their platforms.
          </p>
          <p class="zb-beats">
            They profit from our distraction.<br />
            They profit from our discontentment.<br />
            They profit from our compulsive consumption of their content.<br />
            They profit. We languish.
          </p>
          <blockquote>
            <p>
              "To flourish means to live within an optimal range of human
              functioning, one that connotes goodness, generativity, growth,
              and resilience."
            </p>
            <p><cite>Fredrickson &amp; Losada, 2005</cite></p>
          </blockquote>
          <p>
            Zenborg is my exploration into mindful technology. A way to
            leverage software and AI as a driver for flourishing.
          </p>
        </details>
      </div>
    </Section>

    <Section id="get" eyebrow="Get it">
      <div class="prose">
        <p>For Macs with Apple Silicon (M1 or later), macOS 11 or newer.</p>
        <a class="door__email" href={download}>Download Zenborg</a>
        <p class="zb-note">
          <strong>First launch.</strong> The app is signed but not yet
          notarized, so macOS will refuse to open it the first time. Open
          System Settings, then Privacy &amp; Security, scroll down and click
          Open Anyway. Once is enough.
        </p>
        <p>
          <strong>Local-first.</strong> Everything stays on your Mac, in
          <code>~/.zenborg</code>. No account, no server.
        </p>
      </div>
    </Section>

    <Section id="next" eyebrow="What's next">
      <div class="prose">
        <p>
          You're one of the first few people trying this. In a week or two,
          I'll ask you how it's going.
        </p>
        <p>
          My goal is to answer: "How can we build software and AI aligned
          with human flourishing?"
        </p>
      </div>
    </Section>
  </main>
</Base>

<style>
  .zb-hero { padding-block-end: calc(var(--section-gap) * 0.5); }
  .zb-hero__name {
    font-size: var(--fs-3xl);
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: -0.03em;
    margin-bottom: calc(var(--spacing) * 8);
  }
  .zb-hero__pitch {
    font-size: var(--fs-lg);
    line-height: 1.3;
    letter-spacing: -0.012em;
    max-width: 36ch;
  }
  .zb-hero__meta {
    margin-top: calc(var(--spacing) * 8);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .zb-hero__meta a { color: var(--color-text); }
  /* The gesture matrix reuses .projects; it has no category row, so the h2 opens the cell. */
  .project__name { font-size: var(--fs-lg); }

  .zb-shots {
    display: grid;
    grid-template-columns: 1fr;
    gap: calc(var(--spacing) * 8);
  }
  @media (min-width: 768px) {
    .zb-shots { grid-template-columns: repeat(3, 1fr); gap: calc(var(--spacing) * 6); }
  }
  .zb-shot figcaption {
    margin-top: calc(var(--spacing) * 3);
    font-size: var(--fs-sm);
    color: var(--color-muted);
  }
  .zb-shot__slot {
    aspect-ratio: 16 / 10;
    border: 1px dashed var(--color-faint);
    display: grid;
    place-items: center;
    padding: calc(var(--spacing) * 4);
    text-align: center;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.04em;
    color: var(--color-muted);
    overflow-wrap: anywhere;
  }

  .zb-note { margin-top: calc(var(--spacing) * 8); }
  .zb-list {
    margin-top: calc(var(--spacing) * 6);
    max-width: var(--measure);
    border-bottom: 1px solid var(--color-rule);
  }
  .zb-list li {
    border-top: 1px solid var(--color-rule);
    padding-block: calc(var(--spacing) * 3);
  }
  .zb-list strong { font-weight: 500; }
  .zb-after { margin-top: calc(var(--spacing) * 6); color: var(--color-muted); }
  .zb-hero .research-q-inline { margin-top: calc(var(--spacing) * 8); }
  .zb-beats { font-size: var(--fs-md); }
  cite { font-style: normal; font-family: var(--font-mono); font-size: var(--fs-xs); letter-spacing: 0.04em; }
  code {
    font-family: var(--font-mono);
    font-size: 0.9em;
    background: var(--color-rule);
    padding: 0.1em 0.35em;
    border-radius: 2px;
  }
</style>
